# ==============================================================================
# Hamle School Information System - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in the values.
# The backend loads this file automatically via dotenv.

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------

# MongoDB Connection URI (Required)
MONGODB_URI=mongodb://localhost:27017/hamle-sis

# Port for the backend application (Default: 5000)
PORT=5000

# Secret string used to sign session cookies and JWT tokens (Required)
# Make sure to use a long, complex, random string in production!
SESSION_SECRET=your_jwt_signing_secret_here

# Allowed origins for CORS (comma-separated, e.g. for dev/production apps)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Node environment mode (development or production)
NODE_ENV=development

# Logging output level (debug, info, warn, error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Frontend Configuration (Expo)
# ------------------------------------------------------------------------------

# Public backend domain for API requests (Required)
# Do not include the protocol (http:// or https://) - it will be prepended automatically.
# For local development use: localhost:5000
# The app uses http:// for localhost domains and https:// for production domains.
EXPO_PUBLIC_DOMAIN=localhost:5000

# Base URL path if host under a subpath (Default: /)
BASE_PATH=/
